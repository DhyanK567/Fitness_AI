        {"fieldname": "branch_id", "fieldtype": "Link", "label": "Branch", "options": "Branch", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "name", "fieldtype": "Data", "label": "Equipment Name", "reqd": 1, "in_list_view": 1},
        {"fieldname": "equipment_type", "fieldtype": "Select", "label": "Type", "options": "Cardio\nStrength\nFunctional\nYoga/Pilates\nRecovery\nOther", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "brand", "fieldtype": "Data", "label": "Brand"},
        {"fieldname": "model", "fieldtype": "Data", "label": "Model"},
        {"fieldname": "serial_number", "fieldtype": "Data", "label": "Serial Number"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Available\nIn Use\nMaintenance\nRetired", "default": "Available", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "purchase_date", "fieldtype": "Date", "label": "Purchase Date"},
        {"fieldname": "warranty_expiry", "fieldtype": "Date", "label": "Warranty Expiry"},
        {"fieldname": "last_maintenance_at", "fieldtype": "Datetime", "label": "Last Maintenance", "read_only": 1},
        {"fieldname": "next_maintenance_at", "fieldtype": "Datetime", "label": "Next Maintenance Due", "read_only": 1, "in_list_view": 1},
        {"fieldname": "location", "fieldtype": "Data", "label": "Location/Room"},
        {"fieldname": "notes", "fieldtype": "Text", "label": "Notes"},
        {"fieldname": "metadata", "fieldtype": "JSON", "label": "Metadata", "hidden": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Front Desk", "read": 1, "write": 1, "create": 1, "report": 1}
    ],
    "index_web_pages_for_search": 0,
    "is_submittable": 0,
