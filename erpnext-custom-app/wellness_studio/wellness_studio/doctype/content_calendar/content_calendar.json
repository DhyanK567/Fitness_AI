{
    "name": "Content Calendar",
    "module": "Wellness Studio",
    "custom": 1,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 1,
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1,
    "allow_rename": 1,
    "allow_import": 1,
    "allow_export": 1,
    "allow_print": 1,
    "allow_email": 1,
    "allow_copy": 1,
    "allow_delete": 1,
    "allow_cancel": 1,
    "allow_amend": 1,
    "allow_submit": 0,
    "allow_incomplete": 0,
    "engine": "InnoDB",
    "fields": [
        {"fieldname": "tenant_id", "fieldtype": "Link", "label": "Tenant", "options": "Studio Tenant", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "channel", "fieldtype": "Select", "label": "Channel", "options": "Social\nEmail\nBlog\nPush\nSMS\nWhatsApp\nIn-App", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "content_type", "fieldtype": "Select", "label": "Content Type", "options": "Post\nStory\nReel\nEmail\nNewsletter\nPush\nSMS\nWhatsApp\nIn-App Banner", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "title", "fieldtype": "Data", "label": "Title"},
        {"fieldname": "body", "fieldtype": "Long Text", "label": "Body", "reqd": 1},
        {"fieldname": "media_urls", "fieldtype": "Table MultiSelect", "label": "Media URLs", "options": "Media URL"},
        {"fieldname": "scheduled_at", "fieldtype": "Datetime", "label": "Scheduled At", "reqd": 1, "in_list_view": 1},
        {"fieldname": "published_at", "fieldtype": "Datetime", "label": "Published At", "read_only": 1},
        {"fieldname": "target_segments", "fieldtype": "Table MultiSelect", "label": "Target Segments", "options": "Audience Segment", "reqd": 1},
        {"fieldname": "utm_params", "fieldtype": "JSON", "label": "UTM Parameters"},
        {"fieldname": "ab_test_variant", "fieldtype": "Data", "label": "A/B Test Variant"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nScheduled\nPublished\nFailed", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "external_id", "fieldtype": "Data", "label": "External ID"},
        {"fieldname": "metrics", "fieldtype": "JSON", "label": "Metrics", "read_only": 1},
        {"fieldname": "created_by", "fieldtype": "Link", "label": "Created By", "options": "User", "read_only": 1},
        {"fieldname": "metadata", "fieldtype": "JSON", "label": "Metadata", "hidden": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Front Desk", "read": 1, "write": 1, "create": 1, "report": 1}
    ],
    "index_web_pages_for_search": 0,
    "is_submittable": 0,
    "title_field": "title",
    "search_fields": "title,channel,content_type,status"
}