{
    "name": "Review",
    "module": "Wellness Studio",
    "custom": 1,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 1,
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1,
    "allow_rename": 1,
    "allow_import": 1,
    "allow_export": 1,
    "allow_print": 1,
    "allow_email": 1,
    "allow_copy": 1,
    "allow_delete": 1,
    "allow_cancel": 1,
    "allow_amend": 1,
    "allow_submit": 0,
    "allow_incomplete": 0,
    "engine": "InnoDB",
    "fields": [
        {"fieldname": "tenant_id", "fieldtype": "Link", "label": "Tenant", "options": "Studio Tenant", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "platform", "fieldtype": "Select", "label": "Platform", "options": "Google\nFacebook\nYelp\nInstagram\nInternal", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "external_id", "fieldtype": "Data", "label": "External ID", "reqd": 1, "in_list_view": 1},
        {"fieldname": "author_name", "fieldtype": "Data", "label": "Author Name", "reqd": 1, "in_list_view": 1},
        {"fieldname": "author_profile_url", "fieldtype": "Data", "label": "Author Profile URL"},
        {"fieldname": "rating", "fieldtype": "Float", "label": "Rating", "reqd": 1, "in_list_view": 1},
        {"fieldname": "review_title", "fieldtype": "Data", "label": "Title"},
        {"fieldname": "content", "fieldtype": "Text", "label": "Content", "reqd": 1},
        {"fieldname": "sentiment", "fieldtype": "Select", "label": "Sentiment", "options": "Positive\nNeutral\nNegative", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "language", "fieldtype": "Data", "label": "Language"},
        {"fieldname": "response", "fieldtype": "Text", "label": "Response"},
        {"fieldname": "responded_at", "fieldtype": "Datetime", "label": "Responded At", "read_only": 1},
        {"fieldname": "responded_by", "fieldtype": "Link", "label": "Responded By", "options": "User", "read_only": 1},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "New\nResponded\nFlagged\nEscalated\nReported", "default": "New", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "metadata", "fieldtype": "JSON", "label": "Metadata", "hidden": 1},
        {"fieldname": "fetched_at", "fieldtype": "Datetime", "label": "Fetched At", "reqd": 1, "in_list_view": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Front Desk", "read": 1, "write": 1, "create": 1, "report": 1}
    ],
    "index_web_pages_for_search": 0,
    "is_submittable": 0,
    "title_field": "author_name",
    "search_fields": "author_name,platform,rating,sentiment"
}