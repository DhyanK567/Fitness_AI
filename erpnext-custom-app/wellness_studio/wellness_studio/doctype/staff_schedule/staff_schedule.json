{
    "name": "Staff Schedule",
    "module": "Wellness Studio",
    "custom": 1,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 0,
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1,
    "allow_rename": 1,
    "allow_import": 1,
    "allow_export": 1,
    "allow_print": 1,
    "allow_email": 1,
    "allow_copy": 1,
    "allow_delete": 1,
    "allow_cancel": 1,
    "allow_amend": 1,
    "allow_submit": 0,
    "allow_incomplete": 0,
    "engine": "InnoDB",
    "fields": [
        {"fieldname": "tenant_id", "fieldtype": "Link", "label": "Tenant", "options": "Studio Tenant", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "staff_id", "fieldtype": "Link", "label": "Staff Member", "options": "User", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "branch_id", "fieldtype": "Link", "label": "Branch", "options": "Branch", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "schedule_type", "fieldtype": "Select", "label": "Schedule Type", "options": "Class\nShift\nAvailability", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "class_type_id", "fieldtype": "Link", "label": "Class Type", "options": "WS Class Type", "depends_on": "eval:doc.schedule_type=='Class'"},
        {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "end_date", "fieldtype": "Date", "label": "End Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "days_of_week", "fieldtype": "Table MultiSelect", "label": "Days of Week", "options": "Day of Week", "reqd": 1},
        {"fieldname": "start_time", "fieldtype": "Time", "label": "Start Time", "reqd": 1, "in_list_view": 1},
        {"fieldname": "end_time", "fieldtype": "Time", "label": "End Time", "reqd": 1, "in_list_view": 1},
        {"fieldname": "is_recurring", "fieldtype": "Check", "label": "Recurring", "default": 1},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Active\nInactive\nCancelled", "default": "Active", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "notes", "fieldtype": "Text", "label": "Notes"},
        {"fieldname": "metadata", "fieldtype": "JSON", "label": "Metadata", "hidden": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Front Desk", "read": 1, "write": 1, "create": 1, "report": 1},
        {"role": "Studio Trainer", "read": 1}
    ],
    "index_web_pages_for_search": 0,
    "is_submittable": 0,
    "title_field": "staff_id",
    "search_fields": "staff_id,schedule_type,branch_id"
}