{
    "name": "Growth Experiment",
    "module": "Wellness Studio",
    "custom": 1,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 0,
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1,
    "allow_rename": 1,
    "allow_import": 1,
    "allow_export": 1,
    "allow_print": 1,
    "allow_email": 1,
    "allow_copy": 1,
    "allow_delete": 1,
    "allow_cancel": 1,
    "allow_amend": 1,
    "allow_submit": 0,
    "allow_incomplete": 0,
    "engine": "InnoDB",
    "fields": [
        {"fieldname": "tenant_id", "fieldtype": "Link", "label": "Tenant", "options": "Studio Tenant", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "experiment_name", "fieldtype": "Data", "label": "Experiment Name", "reqd": 1, "in_list_view": 1},
        {"fieldname": "hypothesis", "fieldtype": "Text", "label": "Hypothesis", "reqd": 1},
        {"fieldname": "variant_control", "fieldtype": "JSON", "label": "Control Variant", "reqd": 1},
        {"fieldname": "variant_treatment", "fieldtype": "JSON", "label": "Treatment Variant", "reqd": 1},
        {"fieldname": "target_metric", "fieldtype": "Select", "label": "Target Metric", "options": "Conversion Rate\nRevenue Per Member\nRetention Rate\nReferral Rate\nAttendance Rate", "reqd": 1, "in_list_view": 1},
        {"fieldname": "minimum_detectable_effect", "fieldtype": "Float", "label": "Minimum Detectable Effect", "reqd": 1},
        {"fieldname": "traffic_allocation", "fieldtype": "Int", "label": "Traffic Allocation %", "reqd": 1, "default": 50},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nRunning\nCompleted\nArchived", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "start_date", "fieldtype": "Date", "label": "Start Date", "reqd": 1, "in_list_view": 1},
        {"fieldname": "end_date", "fieldtype": "Date", "label": "End Date", "in_list_view": 1},
        {"fieldname": "results", "fieldtype": "JSON", "label": "Results", "read_only": 1},
        {"fieldname": "significance_level", "fieldtype": "Float", "label": "Significance Level", "default": 0.05},
        {"fieldname": "created_by", "fieldtype": "Link", "label": "Created By", "options": "User", "read_only": 1},
        {"fieldname": "metadata", "fieldtype": "JSON", "label": "Metadata", "hidden": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Front Desk", "read": 1, "report": 1}
    ],
    "index_web_pages_for_search": 0,
    "is_submittable": 0,
    "title_field": "experiment_name",
    "search_fields": "experiment_name,status,target_metric"
}