{
    "name": "Marketing Campaign",
    "module": "Wellness Studio",
    "custom": 1,
    "istable": 0,
    "issingle": 0,
    "quick_entry": 0,
    "track_changes": 1,
    "track_seen": 1,
    "track_views": 1,
    "allow_rename": 1,
    "allow_import": 1,
    "allow_export": 1,
    "allow_print": 1,
    "allow_email": 1,
    "allow_copy": 1,
    "allow_delete": 1,
    "allow_cancel": 1,
    "allow_amend": 1,
    "allow_submit": 0,
    "allow_incomplete": 0,
    "engine": "InnoDB",
    "fields": [
        {"fieldname": "tenant_id", "fieldtype": "Link", "label": "Tenant", "options": "Studio Tenant", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "campaign_name", "fieldtype": "Data", "label": "Campaign Name", "reqd": 1, "in_list_view": 1},
        {"fieldname": "description", "fieldtype": "Text", "label": "Description"},
        {"fieldname": "channel", "fieldtype": "Select", "label": "Channel", "options": "Meta\nGoogle\nTikTok\nEmail\nSMS\nWhatsApp\nPush", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "objective", "fieldtype": "Select", "label": "Objective", "options": "Awareness\nTraffic\nLeads\nConversions\nEngagement\nRetention", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "targeting", "fieldtype": "JSON", "label": "Targeting", "reqd": 1},
        {"fieldname": "creative", "fieldtype": "JSON", "label": "Creative", "reqd": 1},
        {"fieldname": "budget_type", "fieldtype": "Select", "label": "Budget Type", "options": "Daily\nLifetime", "reqd": 1, "default": "Daily"},
        {"fieldname": "budget_amount", "fieldtype": "Currency", "label": "Budget Amount", "reqd": 1},
        {"fieldname": "budget_currency", "fieldtype": "Select", "label": "Currency", "options": "INR\nUSD\nEUR\nGBP", "default": "INR"},
        {"fieldname": "budget_spent", "fieldtype": "Currency", "label": "Budget Spent", "default": 0, "read_only": 1, "in_list_view": 1},
        {"fieldname": "schedule_start", "fieldtype": "Datetime", "label": "Schedule Start", "reqd": 1, "in_list_view": 1},
        {"fieldname": "schedule_end", "fieldtype": "Datetime", "label": "Schedule End", "in_list_view": 1},
        {"fieldname": "dayparting", "fieldtype": "JSON", "label": "Dayparting"},
        {"fieldname": "landing_page_url", "fieldtype": "Data", "label": "Landing Page URL"},
        {"fieldname": "utm_params", "fieldtype": "JSON", "label": "UTM Parameters"},
        {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Draft\nActive\nPaused\nCompleted\nArchived", "default": "Draft", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "metrics", "fieldtype": "JSON", "label": "Metrics", "read_only": 1},
        {"fieldname": "created_by", "fieldtype": "Link", "label": "Created By", "options": "User", "read_only": 1},
        {"fieldname": "metadata", "fieldtype": "JSON", "label": "Metadata", "hidden": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Admin", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
        {"role": "Studio Front Desk", "read": 1, "write": 1, "create": 1, "report": 1}
    ],
    "index_web_pages_for_search": 0,
    "is_submittable": 0,
    "title_field": "campaign_name",
    "search_fields": "campaign_name,channel,objective,status"
}