# ============================================================================
# Fitness AI Backend - Environment Configuration Template
# Copy this file to .env and fill in your values
# ============================================================================
OPENAI_API_KEY=
COHERE_API_KEY=
# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# ----------------------------------------------------------------------------
# Database (PostgreSQL with pgvector)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql://wsos:wsos_local@localhost:5432/wsos?schema=public

# ----------------------------------------------------------------------------
# Redis (for caching, rate limiting, AI sessions)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# JWT & Encryption
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-base64-secret-here

# MFA Encryption Key - MUST be 32 bytes (base64 encoded)
# Generate with: openssl rand -base64 32
# CRITICAL: Never commit real values. Use different keys per environment.
MFA_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY_PREVIOUS=

# ----------------------------------------------------------------------------
# Tenant Resolution
# ----------------------------------------------------------------------------
TENANT_BASE_DOMAIN=fitness.local
# API_TENANT_HOST=  # Optional: hardcode tenant host for API calls

# ----------------------------------------------------------------------------
# Email Delivery (production requires at least one)
# ----------------------------------------------------------------------------
# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Resend API (alternative to SMTP)
RESEND_API_KEY=
INVITATION_FROM_EMAIL="Wellness Studio OS <onboarding@your-domain.example>"

# ----------------------------------------------------------------------------
# ERPNext Integration
# ----------------------------------------------------------------------------
FRAPPE_BASE_URL=https://your-erpnext-instance.com
FRAPPE_API_KEY=your-api-key
FRAPPE_API_SECRET=your-api-secret
FRAPPE_EXPECTED_APP_VERSION=0.0.1
FRAPPE_TIMEOUT_MS=10000

# ----------------------------------------------------------------------------
# Razorpay Payments
# ----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Google OAuth
# ----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Dev-Only Flags (MUST BE DISABLED OUTSIDE DEVELOPMENT)
# The application will REFUSE TO START if these are enabled in any NODE_ENV other than 'development'
# ----------------------------------------------------------------------------
# Auto-verify owner email without sending actual email
# Use only for local development when no email service is configured
AUTH_DEV_AUTO_VERIFY=false

# Allow x-tenant-code-dev header for dev tenant override
# Only works when NODE_ENV=development AND this is explicitly set to 'true'
ALLOW_DEV_TENANT_HEADER=false

# ============================================================================
# Notes:
# 1. Never commit .env files with real secrets
# 2. Use different secrets for dev/staging/production
# 3. Rotate MFA_ENCRYPTION_KEY periodically using MFA_ENCRYPTION_KEY_PREVIOUS
# 4. AUTH_DEV_AUTO_VERIFY and ALLOW_DEV_TENANT_HEADER must be false/unset in staging/production/test
# ============================================================================


# Import / Export
IMPORT_STORE=postgres

# OTP and authentication security
OTP_HASH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Reverse proxy and request limits
TRUST_PROXY_HOPS=1
REQUEST_BODY_LIMIT=256kb

# CORS - local development
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ERPNext callback authentication
FRAPPE_CALLBACK_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional: dedicated webhook ingestion database
# WEBHOOK_INGEST_DATABASE_URL=

# AI model configuration (Primary Provider)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=replace-with-your-groq-api-key

# Fallback Provider Configuration (for resilience when primary is rate-limited)
# If not set, defaults to gemini with its own model/key
FALLBACK_LLM_PROVIDER=gemini
FALLBACK_LLM_MODEL=gemini-1.5-flash
FALLBACK_LLM_API_KEY=replace-with-your-gemini-api-key

# Provider-specific token limits (Groq on-demand tier)
GROQ_TPM_LIMIT=8000
GROQ_MAX_INPUT_TOKENS=6000
GROQ_MAX_OUTPUT_TOKENS=2000
GROQ_CONTEXT_WINDOW=8192

# Provider-specific token limits (Gemini free tier)
GEMINI_TPM_LIMIT=1500000
GEMINI_MAX_INPUT_TOKENS=1000000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_CONTEXT_WINDOW=1048576

# Default provider limits (fallback)
DEFAULT_TPM_LIMIT=8000
DEFAULT_MAX_INPUT_TOKENS=6000
DEFAULT_MAX_OUTPUT_TOKENS=2000
DEFAULT_CONTEXT_WINDOW=8192

# Token budget configuration
LLM_TOKEN_SAFETY_MARGIN=0.15
LLM_MAX_INPUT_TOKENS=6000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_HISTORY_TURNS=10
LLM_MIN_HISTORY_TURNS=3
LLM_TOKEN_SUMMARIZE_THRESHOLD=4000

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_TENANT_HOST=demo.fitness.local
