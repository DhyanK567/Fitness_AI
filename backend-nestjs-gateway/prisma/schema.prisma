generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ai", "audit", "config", "iam", "ops", "platform"]
}

model Tenant {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                       String                    @unique @db.VarChar(40)
  legalName                  String                    @map("legal_name") @db.VarChar(200)
  displayName                String                    @map("display_name") @db.VarChar(120)
  tierId                     String                    @map("tier_id") @db.Uuid
  status                     String                    @default("active") @db.VarChar(20)
  timezone                   String                    @default("Asia/Kolkata") @db.VarChar(60)
  currency                   String                    @default("INR") @db.Char(3)
  locale                     String                    @default("en-IN") @db.VarChar(10)
  erpCompany                 String?                   @map("erp_company") @db.VarChar(140)
  dataRegion                 String                    @default("in-west") @map("data_region") @db.VarChar(20)
  closedAt                   DateTime?                 @map("closed_at") @db.Timestamptz(6)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  trialStartsAt              DateTime?                 @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt                DateTime?                 @map("trial_ends_at") @db.Timestamptz(6)
  pendingDeletionAt          DateTime?                 @map("pending_deletion_at") @db.Timestamptz(6)
  audit_logs                 AuditLog[]
  event_categories           EventCategory[]
  faq_entries                FaqEntry[]
  notification_rules         NotificationRule[]
  notification_templates     NotificationTemplate[]
  tenant_branding            TenantBranding?
  tenant_settings            TenantSetting[]
  auth_action_tokens         AuthActionToken[]
  auth_identities            AuthIdentity[]
  auth_sessions              AuthSession[]
  login_rate_limit_buckets   LoginRateLimitBucket[]
  otp_challenges             OtpChallenge[]
  permission_grants          PermissionGrant[]
  permissions                Permission[]
  role_permissions           RolePermission[]
  roles                      Role[]
  team_invitations           TeamInvitation[]
  totp_recovery_codes        TotpRecoveryCode[]
  user_credentials           UserCredential[]
  user_erp_links             UserErpLink[]
  user_role_assignments      UserRoleAssignment[]
  user_totp                  UserTotp[]
  users                      User[]
  idempotency_keys           IdempotencyKey[]
  membership_freeze_requests MembershipFreezeRequest[]
  outbox_events              OutboxEvent[]
  studio_attendance          StudioAttendance[]
  studio_bookings            StudioBooking[]
  studio_classes             StudioClass[]
  studio_events              StudioEvent[]
  studio_leads               StudioLead[]
  studio_members             StudioMember[]
  studio_memberships         StudioMembership[]
  studio_payments            StudioPayment[]
  studio_session_feedback    StudioSessionFeedback[]
  trainer_progress_notes     TrainerProgressNote[]
  trainer_workout_plans      TrainerWorkoutPlan[]
  webhook_inbox              WebhookInbox[]
  branches                   Branch[]
  recurring_payment_consents RecurringPaymentConsent[]
  studios                    Studio[]
  tenant_domains             TenantDomain[]
  tenant_feature_flags       TenantFeatureFlag[]
  tenant_invoices            TenantInvoice[]
  tenant_subscriptions       TenantSubscription[]
  subscription_tiers         SubscriptionTier          @relation(fields: [tierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tenants")
  @@schema("platform")
}

model SubscriptionTier {
  id                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                @unique @db.VarChar(40)
  displayName            String                @map("display_name") @db.VarChar(120)
  status                 String                @default("active") @db.VarChar(20)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  provider_plan_mappings ProviderPlanMapping[]
  tenant_subscriptions   TenantSubscription[]
  tenants                Tenant[]
  tier_features          TierFeature[]

  @@map("subscription_tiers")
  @@schema("platform")
}

model TierFeature {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tierId             String           @map("tier_id") @db.Uuid
  featureCode        String           @map("feature_code") @db.VarChar(80)
  isEnabled          Boolean          @default(true) @map("is_enabled")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  subscription_tiers SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tierId, featureCode])
  @@map("tier_features")
  @@schema("platform")
}

model ProviderPlanMapping {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           String           @default("razorpay") @db.VarChar(40)
  providerPlanId     String           @map("provider_plan_id") @db.VarChar(120)
  tierId             String           @map("tier_id") @db.Uuid
  billingInterval    String           @default("monthly") @map("billing_interval") @db.VarChar(20)
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  subscription_tiers SubscriptionTier @relation(fields: [tierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([provider, providerPlanId], map: "uq_provider_plan")
  @@map("provider_plan_mappings")
  @@schema("platform")
}

model TenantSubscription {
  id                         String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                    @map("tenant_id") @db.Uuid
  tierId                     String                    @map("tier_id") @db.Uuid
  status                     String                    @default("trialing") @db.VarChar(40)
  provider                   String                    @default("razorpay") @db.VarChar(40)
  razorpaySubscriptionId     String?                   @unique @map("razorpay_subscription_id") @db.VarChar(120)
  razorpayPlanId             String?                   @map("razorpay_plan_id") @db.VarChar(120)
  mandateStatus              String                    @default("pending") @map("mandate_status") @db.VarChar(40)
  currentPeriodStart         DateTime?                 @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd           DateTime?                 @map("current_period_end") @db.Timestamptz(6)
  paidCount                  Int                       @default(0) @map("paid_count")
  totalCount                 Int?                      @map("total_count")
  cancelAtPeriodEnd          Boolean                   @default(false) @map("cancel_at_period_end")
  cancelledAt                DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  trialStartsAt              DateTime?                 @map("trial_starts_at") @db.Timestamptz(6)
  trialEndsAt                DateTime?                 @map("trial_ends_at") @db.Timestamptz(6)
  lastProviderEventAt        DateTime?                 @map("last_provider_event_at") @db.Timestamptz(6)
  lastProviderSyncAt         DateTime?                 @map("last_provider_sync_at") @db.Timestamptz(6)
  lastProviderSnapshot       Json?                     @map("last_provider_snapshot")
  version                    Int                       @default(1)
  createdAt                  DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  recurring_payment_consents RecurringPaymentConsent[]
  tenant_invoices            TenantInvoice[]
  tenants                    Tenant                    @relation(fields: [tenantId], references: [id], onUpdate: NoAction)
  subscription_tiers         SubscriptionTier          @relation(fields: [tierId], references: [id], onUpdate: NoAction)

  @@index([tenantId], map: "ix_tenant_subscriptions_tenant")
  @@index([razorpaySubscriptionId], map: "ix_tenant_subscriptions_provider_id")
  @@map("tenant_subscriptions")
  @@schema("platform")
}

model TenantInvoice {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  subscriptionId       String             @map("subscription_id") @db.Uuid
  provider             String             @default("razorpay") @db.VarChar(40)
  providerInvoiceId    String             @map("provider_invoice_id") @db.VarChar(120)
  providerPaymentId    String?            @map("provider_payment_id") @db.VarChar(120)
  amount               Int
  currency             String             @default("INR") @db.Char(3)
  billingPeriodStart   DateTime           @map("billing_period_start") @db.Timestamptz(6)
  billingPeriodEnd     DateTime           @map("billing_period_end") @db.Timestamptz(6)
  status               String             @db.VarChar(40)
  paidAt               DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant_subscriptions TenantSubscription @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction)
  tenants              Tenant             @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@unique([provider, providerInvoiceId], map: "uq_tenant_invoices_provider_invoice")
  @@index([tenantId], map: "ix_tenant_invoices_tenant")
  @@index([subscriptionId], map: "ix_tenant_invoices_subscription")
  @@map("tenant_invoices")
  @@schema("platform")
}

model RecurringPaymentConsent {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String             @map("tenant_id") @db.Uuid
  subscriptionId       String             @map("subscription_id") @db.Uuid
  provider             String             @default("razorpay") @db.VarChar(40)
  mandateToken         String             @map("mandate_token") @db.VarChar(160)
  maxAmount            Int                @map("max_amount")
  currency             String             @default("INR") @db.Char(3)
  status               String             @default("pending") @db.VarChar(40)
  consentPayload       Json?              @map("consent_payload")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenant_subscriptions TenantSubscription @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction)
  tenants              Tenant             @relation(fields: [tenantId], references: [id], onUpdate: NoAction)

  @@unique([provider, mandateToken], map: "uq_payment_consents_provider_token")
  @@index([tenantId], map: "ix_recurring_payment_consents_tenant")
  @@map("recurring_payment_consents")
  @@schema("platform")
}

model PlatformWebhookInbox {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider            String    @default("razorpay") @db.VarChar(40)
  providerEventId     String    @map("provider_event_id") @db.VarChar(160)
  eventType           String?   @map("event_type") @db.VarChar(80)
  payload             Json
  rawBodySha256       String    @map("raw_body_sha256") @db.Char(64)
  isAmbiguousFallback Boolean   @default(false) @map("is_ambiguous_fallback")
  status              String    @default("received") @db.VarChar(40)
  claimToken          String?   @map("claim_token") @db.Uuid
  claimedAt           DateTime? @map("claimed_at") @db.Timestamptz(6)
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(6)
  quarantinedAt       DateTime? @map("quarantined_at") @db.Timestamptz(6)
  quarantineReason    String?   @map("quarantine_reason")
  retryCount          Int       @default(0) @map("retry_count")
  lastError           String?   @map("last_error")
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerEventId], map: "uq_platform_webhook_inbox_provider_event")
  @@index([receivedAt], map: "ix_platform_webhook_inbox_received")
  @@map("platform_webhook_inbox")
  @@schema("platform")
}

model TenantDomain {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  hostname  String   @unique @db.VarChar(253)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenants   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId], map: "ix_tenant_domains_tenant")
  @@map("tenant_domains")
  @@schema("platform")
}

model TenantFeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  featureCode String   @map("feature_code") @db.VarChar(80)
  isEnabled   Boolean  @default(false) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenants     Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, featureCode])
  @@map("tenant_feature_flags")
  @@schema("platform")
}

model Studio {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  name                  String               @db.VarChar(160)
  status                String               @default("active") @db.VarChar(20)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  user_role_assignments UserRoleAssignment[]
  branches              Branch[]
  tenants               Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId], map: "ix_studios_tenant")
  @@map("studios")
  @@schema("platform")
}

model Branch {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  studioId              String               @map("studio_id") @db.Uuid
  name                  String               @db.VarChar(160)
  timezone              String               @default("Asia/Kolkata") @db.VarChar(60)
  status                String               @default("active") @db.VarChar(20)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  user_role_assignments UserRoleAssignment[]
  studios               Studio               @relation(fields: [studioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants               Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  equipment             Equipment[]

  @@unique([tenantId, studioId, name])
  @@index([tenantId, studioId], map: "ix_branches_tenant_studio")
  @@map("branches")
  @@schema("platform")
}

model User {
  id                                                                        String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                                                                  String                    @map("tenant_id") @db.Uuid
  userType                                                                  String                    @map("user_type") @db.VarChar(10)
  email                                                                     String?                   @db.Citext
  phoneE164                                                                 String?                   @map("phone_e164") @db.VarChar(16)
  displayName                                                               String                    @map("display_name") @db.VarChar(160)
  status                                                                    String                    @default("active") @db.VarChar(20)
  mustResetPassword                                                         Boolean                   @default(false) @map("must_reset_password")
  lastLoginAt                                                               DateTime?                 @map("last_login_at") @db.Timestamptz(6)
  deactivatedAt                                                             DateTime?                 @map("deactivated_at") @db.Timestamptz(6)
  createdAt                                                                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                                 DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  mfaEnforced                                                               Boolean                   @default(false) @map("mfa_enforced")
  failedLoginAttempts                                                       Int                       @default(0) @map("failed_login_attempts")
  lockedUntil                                                               DateTime?                 @map("locked_until") @db.Timestamptz(6)
  faq_entries                                                               FaqEntry[]
  auth_action_tokens                                                        AuthActionToken[]
  auth_identities                                                           AuthIdentity[]
  auth_sessions                                                             AuthSession[]
  permission_grants                                                         PermissionGrant[]
  totp_recovery_codes                                                       TotpRecoveryCode[]
  user_credentials                                                          UserCredential[]
  user_erp_links                                                            UserErpLink[]
  user_role_assignments                                                     UserRoleAssignment[]
  user_totp                                                                 UserTotp[]
  tenants                                                                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membership_freeze_requests_membership_freeze_requests_requested_byTousers MembershipFreezeRequest[] @relation("membership_freeze_requests_requested_byTousers")
  membership_freeze_requests_membership_freeze_requests_reviewed_byTousers  MembershipFreezeRequest[] @relation("membership_freeze_requests_reviewed_byTousers")
  studio_members                                                            StudioMember[]
  studio_session_feedback_studio_session_feedback_submitted_byTousers       StudioSessionFeedback[]   @relation("studio_session_feedback_submitted_byTousers")
  studio_session_feedback_studio_session_feedback_trainer_user_idTousers    StudioSessionFeedback[]   @relation("studio_session_feedback_trainer_user_idTousers")
  trainer_progress_notes                                                    TrainerProgressNote[]
  trainer_workout_plans                                                     TrainerWorkoutPlan[]

  @@map("users")
  @@schema("iam")
}

model UserCredential {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  failedAttempts    Int       @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  tenants           Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, userId])
  @@map("user_credentials")
  @@schema("iam")
}

model AuthIdentity {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(30)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  tenants         Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, provider, providerSubject])
  @@unique([tenantId, userId, provider], map: "uq_auth_identities_tenant_user_provider")
  @@map("auth_identities")
  @@schema("iam")
}

model Role {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  code                  String               @db.VarChar(60)
  displayName           String               @map("display_name") @db.VarChar(120)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  role_permissions      RolePermission[]
  tenants               Tenant               @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user_role_assignments UserRoleAssignment[]

  @@unique([tenantId, code])
  @@map("roles")
  @@schema("iam")
}

model Permission {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String            @map("tenant_id") @db.Uuid
  code              String            @db.VarChar(100)
  description       String?           @db.VarChar(255)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  permission_grants PermissionGrant[]
  tenants           Tenant            @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role_permissions  RolePermission[]

  @@unique([tenantId, code])
  @@map("permissions")
  @@schema("iam")
}

model RolePermission {
  tenantId     String     @map("tenant_id") @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions  Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles        Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants      Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([tenantId, roleId, permissionId])
  @@map("role_permissions")
  @@schema("iam")
}

model UserRoleAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  studioId  String?  @map("studio_id") @db.Uuid
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  branches  Branch?  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles     Role     @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  studios   Studio?  @relation(fields: [studioId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants   Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users     User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenantId, userId, roleId, studioId, branchId])
  @@map("user_role_assignments")
  @@schema("iam")
}

model PermissionGrant {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  resourceType String?    @map("resource_type") @db.VarChar(60)
  resourceRef  String?    @map("resource_ref") @db.VarChar(140)
  expiresAt    DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  permissions  Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tenants      Tenant     @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("permission_grants")
  @@schema("iam")
}

model UserErpLink {
