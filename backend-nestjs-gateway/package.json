{
  "name": "@fitness-ai/backend-nestjs-gateway",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && jest --passWithNoTests --forceExit",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests --forceExit",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@fitness-ai/error-codes": "workspace:*",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^12.0.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^5.20.0",
    "@types/uuid": "^11.0.0",
    "@wsos/ai-tool-definitions": "workspace:*",
    "@wsos/erp-methods": "workspace:*",
    "axios": "^1.7.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^18.0.8",
    "express": "4.22.1",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "jest": {
    "setupFiles": ["<rootDir>/jest.setup.ts"],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "maxWorkers": 2,
    "testRegex": "(src|tests)/.*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", { "isolatedModules": true }]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!@wsos/ai-tool-definitions|@nestjs)"
    ],
    "moduleNameMapper": {
      "^@nestjs/swagger$": "<rootDir>/tests/__mocks__/nestjs-swagger.mock.ts",
      "^@nestjs/jwt$": "<rootDir>/tests/__mocks__/nestjs-jwt.mock.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
