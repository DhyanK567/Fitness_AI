{
  "name": "Send Message Sub-Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notify",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "e0000001-0001-4000-8000-000000000001",
      "name": "Webhook Trigger (/notify)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        160,
        280
      ]
    },
    {
      "parameters": {},
      "id": "e0000001-0001-4000-8000-000000000002",
      "name": "Sub-Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        160,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const payload = item.json.body || item.json;\n  \n  const tenantId = payload.tenantId || item.json.tenantId || 'default-tenant';\n  const eventId = payload.eventId || item.json.eventId || payload.event_id || `evt_${Date.now()}`;\n  const correlationId = payload.correlationId || item.json.correlationId || `corr_${Date.now()}`;\n  const idempotencyKey = payload.idempotencyKey || item.json.idempotencyKey || `outbox_${eventId}`;\n  const template = payload.template || payload.template_name || item.json.template || 'generic-notification';\n  const to = payload.to || payload.phone || item.json.to || '';\n  const data = payload.data || payload.variables || item.json.data || {};\n  const timestamp = payload.timestamp || new Date().toISOString();\n  \n  const isDirect = Boolean(\n    payload.isDirectDelivery === true ||\n    payload.isDirectDispatch === true ||\n    item.json.isDirectDelivery === true ||\n    payload.source === 'domain_workflow' ||\n    item.json.source === 'domain_workflow'\n  );\n\n  results.push({\n    json: {\n      tenantId,\n      eventId,\n      correlationId,\n      idempotencyKey,\n      template,\n      to,\n      data,\n      timestamp,\n      isDirectDelivery: isDirect,\n      rawPayload: payload\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000003",
      "name": "Normalize & Identify Route",
      "type": "n8n-nodes-base.code",
