        "workflowId": "booking-confirmation"
      },
      "id": "e0000001-0001-4000-8000-000000000007",
      "name": "Route to Booking Confirmation",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1100,
        180
      ]
    },
    {
      "parameters": {
        "workflowId": "payment-received"
      },
      "id": "e0000001-0001-4000-8000-000000000008",
      "name": "Route to Payment Received",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1100,
        280
      ]
    },
    {
      "parameters": {
        "workflowId": "event-registration"
      },
      "id": "e0000001-0001-4000-8000-000000000009",
      "name": "Route to Event Registration",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        1100,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json;\n  results.push({\n    json: {\n      success: false,\n      status: 'error',\n      errorCode: 'UNKNOWN_TEMPLATE',\n      error: `Unsupported or unknown notification template '${d.template}'`,\n      template: d.template,\n      eventId: d.eventId,\n      tenantId: d.tenantId,\n      correlationId: d.correlationId,\n      recipient: d.to,\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000010",
      "name": "Handle Unknown Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\n\nfor (const item of items) {\n  const d = item.json;\n  const rawRecipient = String(d.to || d.phone || '').trim();\n  \n  if (uuidPattern.test(rawRecipient)) {\n    results.push({\n      json: {\n        ...d,\n        isValidPhone: false,\n        errorCode: 'RECIPIENT_PHONE_IS_UUID',\n        errorMessage: `Recipient '${rawRecipient}' is a UUID, not an E.164 phone number. Member phone lookup is required before WhatsApp delivery.`\n      }\n    });\n    continue;\n  }\n  \n  const cleanPhone = rawRecipient.replace(/[^0-9+]/g, '');\n  const digitsOnly = cleanPhone.replace(/[^0-9]/g, '');\n  \n  if (digitsOnly.length < 10 || digitsOnly.length > 15) {\n    results.push({\n      json: {\n        ...d,\n        isValidPhone: false,\n        errorCode: 'INVALID_PHONE_FORMAT',\n        errorMessage: `Recipient phone '${rawRecipient}' is invalid (${digitsOnly.length} digits). Expected E.164 standard phone format (10-15 digits).`\n      }\n    });\n    continue;\n  }\n  \n  results.push({\n    json: {\n      ...d,\n      isValidPhone: true,\n      cleanPhone: cleanPhone.startsWith('+') ? cleanPhone : `+${cleanPhone}`\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000011",
      "name": "Validate Recipient Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        600
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($json.isValidPhone) }}",
              "value2": true
            }
          ]
        }
      },
      "id": "e0000001-0001-4000-8000-000000000012",
      "name": "Check Phone Validity",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1040,
        600
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json;\n  results.push({\n    json: {\n      success: false,\n      status: 'error',\n      errorCode: d.errorCode || 'INVALID_RECIPIENT_PHONE',\n      error: d.errorMessage || 'Recipient phone validation failed',\n      recipient: d.to,\n      template: d.template,\n      eventId: d.eventId,\n      tenantId: d.tenantId,\n      correlationId: d.correlationId,\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000013",
      "name": "Handle Invalid Phone",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        720
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ Boolean($env.MOCK_MODE !== 'false' && $env.WHATSAPP_MOCK_MODE !== 'false' && $env.WHATSAPP_MODE !== 'live') }}",
              "value2": true
            }
          ]
        }
      },
      "id": "e0000001-0001-4000-8000-000000000014",
      "name": "Check Mock Mode",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1260,
        560
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const targetPhone = data.cleanPhone || data.to;\n  results.push({\n    json: {\n      success: true,\n      status: 'mock',\n      deliveryStatus: 'mock_delivered',\n      semanticStatus: 'simulated',\n      deliveryMode: 'mock',\n      isSimulated: true,\n      provider: 'whatsapp_mock',\n      recipient: targetPhone,\n      template: data.template,\n      variables: data.data,\n      eventId: data.eventId,\n      tenantId: data.tenantId,\n      correlationId: data.correlationId,\n      idempotencyKey: data.idempotencyKey,\n      loggedAt: new Date().toISOString(),\n      message: `[MOCK MODE] Simulated WhatsApp notification for template '${data.template}' sent to ${targetPhone}`\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000015",
      "name": "Mock Delivery Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const d = item.json;\n  const parameters = [];\n  \n  if (d.data && typeof d.data === 'object') {\n    for (const [key, val] of Object.entries(d.data)) {\n      parameters.push({\n        type: 'text',\n        text: String(val)\n      });\n    }\n  }\n  \n  const targetPhone = String(d.cleanPhone || d.to).replace(/[^0-9]/g, '');\n  \n  results.push({\n    json: {\n      messaging_product: 'whatsapp',\n      recipient_type: 'individual',\n      to: targetPhone,\n      type: 'template',\n      template: {\n        name: d.template,\n        language: {\n          code: 'en'\n        },\n        components: [\n          {\n            type: 'body',\n            parameters: parameters\n          }\n        ]\n      },\n      metadata: {\n        eventId: d.eventId,\n        tenantId: d.tenantId,\n        correlationId: d.correlationId,\n        template: d.template,\n        recipient: d.cleanPhone || d.to\n      }\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000016",
      "name": "Format Live WhatsApp Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        640
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_NUMBER_ID || '000000000000000'}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.WHATSAPP_ACCESS_TOKEN || ''}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 2000
        }
      },
      "id": "e0000001-0001-4000-8000-000000000017",
      "name": "Call WhatsApp Cloud API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        1720,
        640
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const res = item.json;\n  const meta = res.metadata || {};\n  results.push({\n    json: {\n      success: true,\n      status: 'sent',\n      deliveryStatus: 'sent',\n      semanticStatus: 'provider_accepted',\n      deliveryMode: 'live',\n      isSimulated: false,\n      provider: 'whatsapp_cloud_api',\n      whatsappMessageId: res.messages?.[0]?.id || res.id || 'msg_sent',\n      recipient: meta.recipient,\n      template: meta.template,\n      eventId: meta.eventId,\n      tenantId: meta.tenantId,\n      correlationId: meta.correlationId,\n      sentAt: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "e0000001-0001-4000-8000-000000000018",
      "name": "Format Live Delivery Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1960,
        580
      ]
    },
