# Development Environment Template
# Copy to .env and fill in values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wellness_studio?schema=public&connection_limit=10"

# ============================================
# SERVER
# ============================================
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1

# ============================================
# JWT
# ============================================
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# TENANT
# ============================================
DEFAULT_TENANT_CODE=demo
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ============================================
# ERPNext / Frappe
# ============================================
ERP_URL=https://dev-wellness-studio.frappe.cloud
ERP_API_KEY=dev-api-key
ERP_API_SECRET=dev-api-secret
ERP_INTEGRATION_USER=api_integration@wellness-studio.com

# ============================================
# RAZORPAY (Test Mode)
# ============================================
RAZORPAY_KEY_ID=rzp_test_devkey
RAZORPAY_KEY_SECRET=devsecret
RAZORPAY_WEBHOOK_SECRET=devwebhooksecret

# ============================================
# WHATSAPP (Mock Mode)
# ============================================
WHATSAPP_PHONE_NUMBER_ID=dev_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=dev_business_account_id
WHATSAPP_ACCESS_TOKEN=dev_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dev_verify_token
WHATSAPP_MOCK_MODE=true

# ============================================
# LLM GATEWAY
# ============================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=dev_gemini_key
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=30000

# ============================================
# FEATURE FLAGS (Phase 1 defaults)
# ============================================
# Core AI features
FEATURE_AI_ADMIN=true
FEATURE_AI_ENQUIRY=true
FEATURE_AI_BOOKING=true
FEATURE_AI_RECOMMENDATION=true
FEATURE_AI_FEEDBACK=true

# Phase 2 features
FEATURE_AI_RAG=false

# Phase 3 features
FEATURE_AI_CRM=false

# Phase 4 features
FEATURE_AI_RETENTION=false

# Phase 5 features (NEW - Operations, Growth, Marketing)
FEATURE_AI_OPERATIONS=false
FEATURE_AI_GROWTH=false
FEATURE_AI_MARKETING=false

# ============================================
# REDIS (Optional - add when needed)
# ============================================
# REDIS_URL=redis://localhost:6379

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_PRETTY=true

# ============================================
# MONITORING
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9090