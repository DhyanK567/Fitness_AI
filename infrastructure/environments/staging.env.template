# Staging Environment Template
# Copy to .env and fill in values

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:STAGING_PASSWORD@staging-db:5432/wellness_studio?schema=public&connection_limit=20&sslmode=require"

# ============================================
# SERVER
# ============================================
PORT=4000
NODE_ENV=staging
API_PREFIX=api/v1

# ============================================
# JWT
# ============================================
JWT_SECRET=STAGING_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=STAGING_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# TENANT
# ============================================
DEFAULT_TENANT_CODE=staging
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ============================================
# ERPNext / Frappe
# ============================================
ERP_URL=https://staging-wellness-studio.frappe.cloud
ERP_API_KEY=STAGING_ERP_API_KEY
ERP_API_SECRET=STAGING_ERP_API_SECRET
ERP_INTEGRATION_USER=api_integration@wellness-studio.com

# ============================================
# RAZORPAY (Test Mode)
# ============================================
RAZORPAY_KEY_ID=rzp_test_staging_key
RAZORPAY_KEY_SECRET=STAGING_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=STAGING_WEBHOOK_SECRET

# ============================================
# WHATSAPP (Mock Mode for Staging)
# ============================================
WHATSAPP_PHONE_NUMBER_ID=staging_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=staging_business_account_id
WHATSAPP_ACCESS_TOKEN=STAGING_WHATSAPP_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=STAGING_WEBHOOK_VERIFY
WHATSAPP_MOCK_MODE=true

# ============================================
# LLM GATEWAY
# ============================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=STAGING_GEMINI_KEY
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=30000

# ============================================
# FEATURE FLAGS (Staging - more features enabled)
# ============================================
# Core AI features
FEATURE_AI_ADMIN=true
FEATURE_AI_ENQUIRY=true
FEATURE_AI_BOOKING=true
FEATURE_AI_RECOMMENDATION=true
FEATURE_AI_FEEDBACK=true

# Phase 2 features
FEATURE_AI_RAG=true

# Phase 3 features
FEATURE_AI_CRM=true

# Phase 4 features
FEATURE_AI_RETENTION=true

# Phase 5 features
FEATURE_AI_OPERATIONS=true
FEATURE_AI_GROWTH=true
FEATURE_AI_MARKETING=true

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://staging-redis:6379

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_PRETTY=false

# ============================================
# MONITORING
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://staging-otel-collector:4318
METRICS_PORT=9090
SENTRY_DSN=STAGING_SENTRY_DSN