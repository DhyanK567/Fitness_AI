# Production Environment Template
# Copy to .env and fill in values
# NEVER COMMIT THIS FILE WITH REAL VALUES

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://postgres:PROD_PASSWORD@prod-db:5432/wellness_studio?schema=public&connection_limit=50&sslmode=require"

# ============================================
# SERVER
# ============================================
PORT=4000
NODE_ENV=production
API_PREFIX=api/v1

# ============================================
# JWT
# ============================================
JWT_SECRET=PROD_JWT_SECRET_MIN_64_CHARS_RANDOM
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=PROD_REFRESH_SECRET_MIN_64_CHARS_RANDOM
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# TENANT
# ============================================
DEFAULT_TENANT_CODE=prod
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ============================================
# ERPNext / Frappe
# ============================================
ERP_URL=https://prod-wellness-studio.frappe.cloud
ERP_API_KEY=PROD_ERP_API_KEY
ERP_API_SECRET=PROD_ERP_API_SECRET
ERP_INTEGRATION_USER=api_integration@wellness-studio.com

# ============================================
# RAZORPAY (Live Mode)
# ============================================
RAZORPAY_KEY_ID=rzp_live_PROD_KEY
RAZORPAY_KEY_SECRET=PROD_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=PROD_WEBHOOK_SECRET

# ============================================
# WHATSAPP (Live Mode)
# ============================================
WHATSAPP_PHONE_NUMBER_ID=PROD_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=PROD_BUSINESS_ACCOUNT_ID
WHATSAPP_ACCESS_TOKEN=PROD_WHATSAPP_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=PROD_WEBHOOK_VERIFY
WHATSAPP_MOCK_MODE=false

# ============================================
# LLM GATEWAY
# ============================================
LLM_PROVIDER=gemini
GEMINI_API_KEY=PROD_GEMINI_KEY
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=30000

# ============================================
# FEATURE FLAGS (Production - all stable features)
# ============================================
# Core AI features
FEATURE_AI_ADMIN=true
FEATURE_AI_ENQUIRY=true
FEATURE_AI_BOOKING=true
FEATURE_AI_RECOMMENDATION=true
FEATURE_AI_FEEDBACK=true

# Phase 2 features
FEATURE_AI_RAG=true

# Phase 3 features
FEATURE_AI_CRM=true

# Phase 4 features
FEATURE_AI_RETENTION=true

# Phase 5 features
FEATURE_AI_OPERATIONS=true
FEATURE_AI_GROWTH=true
FEATURE_AI_MARKETING=true

# ============================================
# REDIS
# ============================================
REDIS_URL=redis://prod-redis:6379

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=warn
LOG_PRETTY=false

# ============================================
# MONITORING
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=https://prod-otel-collector:4318
METRICS_PORT=9090
SENTRY_DSN=PROD_SENTRY_DSN
DATADOG_API_KEY=PROD_DATADOG_KEY